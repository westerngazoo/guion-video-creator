{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "guion-playground",
  "version": "0.1.0",
  "identifier": "com.fisicobuenfisico.guion-playground",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Physics Playground",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
